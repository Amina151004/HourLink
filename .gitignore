# ============================================================
#  ROOT .gitignore — hourlink Flutter Project
#  Covers: Flutter · Android · iOS · Firebase · Node.js Functions
#           IntelliJ / Android Studio · VS Code · Windows
# ============================================================


# ────────────────────────────────────────────────────────────
# 🔐 SECRETS & SENSITIVE FILES  ← most important section
# ────────────────────────────────────────────────────────────

# Firebase config files (contain live API keys)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
GoogleService-Info.plist

# Android signing credentials
android/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.cer
**/*.mobileprovision

# Environment variables and secrets
.env
.env.*
.envrc
*.env
secrets/
secret.json
secrets.json
keys.json
api_keys.json
credentials.json
service_account.json
*_service_account.json

# Firebase Admin SDK service account keys
*-firebase-adminsdk-*.json


# ────────────────────────────────────────────────────────────
# 🎯 FLUTTER / DART
# ────────────────────────────────────────────────────────────

# Dart tool cache (fully generated)
.dart_tool/

# Pub cache and lock artifacts
.pub-cache/
.pub/

# Flutter plugin manifest (auto-generated by Flutter)
.flutter-plugins
.flutter-plugins-dependencies

# Build outputs
/build/
**/build/
/coverage/
**/doc/api/

# Flutter web service worker
/web/flutter_service_worker.js

# Symbolication & obfuscation maps
app.*.symbols
app.*.map.json

# Migration working directory
migrate_working_dir/


# ────────────────────────────────────────────────────────────
# 🤖 ANDROID
# ────────────────────────────────────────────────────────────

# Gradle caches and wrapper
android/.gradle/
android/.kotlin/
android/captures/
android/build/
.gradle/

# Machine-specific local config (contains your SDK/JDK paths)
android/local.properties
local.properties

# Android build outputs
/android/app/debug/
/android/app/profile/
/android/app/release/

# Native build intermediaries
android/.cxx/
.cxx/

# Generated plugin registrant
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt

# Gradle wrapper JAR (binary, regenerated automatically)
gradle-wrapper.jar


# ────────────────────────────────────────────────────────────
# 🍎 iOS / macOS
# ────────────────────────────────────────────────────────────

# Xcode user-specific settings
ios/xcuserdata/
**/*.xcuserstate
**/*.xcuserdatad/

# CocoaPods
ios/Pods/
ios/.symlinks/
**/Pods/
**/.symlinks/

# Flutter iOS generated files
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/Flutter/.last_build_id

# Xcode derived data
**/DerivedData/

# iOS generated plugin registrant
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m

# macOS metadata
.DS_Store
**/.DS_Store

# Xcode old-format user files
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside
**/dgph
**/*sync/
.sconsign.dblite
.tags*
**/.vagrant/
Icon?
**/.generated/
ServiceDefinitions.json
profile


# ────────────────────────────────────────────────────────────
# 🔥 FIREBASE
# ────────────────────────────────────────────────────────────

# Firebase debug logs
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log

# Firebase emulator data (optional — remove if you want to commit it)
.firebase/


# ────────────────────────────────────────────────────────────
# ☁️  CLOUD FUNCTIONS (Node.js)
# ────────────────────────────────────────────────────────────

functions/node_modules/
functions/.env
functions/.env.*
functions/*.local
functions/lib/


# ────────────────────────────────────────────────────────────
# 💡 IDE — IntelliJ / Android Studio
# ────────────────────────────────────────────────────────────

.idea/
*.iml
*.ipr
*.iws
.atom/
.buildlog/
.history/


# ────────────────────────────────────────────────────────────
